{
  "name": "SaveSync",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "description": "Versioned account-bound profile and solo checkpoint; legacy blobs remain readable."
    },
    "revision": {
      "type": "integer",
      "description": "Optimistic concurrency revision for managed saves"
    },
    "commit_id": {
      "type": "string",
      "description": "Stable idempotent outbox operation id"
    }
  },
  "required": [
    "data"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}